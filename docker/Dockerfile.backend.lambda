FROM python:3.12-slim-bookworm

# AWS Lambda Web Adapter allows FastAPI/Uvicorn to run in Lambda.
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:0.9.1 \
    /lambda-adapter /opt/extensions/lambda-adapter

WORKDIR /app

# Lambda Web Adapter configuration.
ENV PORT=8080
ENV AWS_LWA_PORT=8080
ENV AWS_LWA_READINESS_CHECK_PATH=/health
ENV PYTHONUNBUFFERED=1

# Lightweight Lambda scraping configuration.
# Uses requests and Scrapling, excluding browser-based fallback tiers.
ENV SCRAPER_MAX_ATTEMPTS=2
ENV SCRAPER_REQUEST_TIMEOUT_SECONDS=10

# Lambda permits application writes only under /tmp.
ENV HOME=/tmp
ENV XDG_CACHE_HOME=/tmp/.cache

# Install backend dependencies.
COPY backend/requirements.txt /app/requirements.txt

RUN pip install --no-cache-dir -r /app/requirements.txt \
    && pip install --no-cache-dir --upgrade \
        "jaraco.context>=6.1.0" \
        "wheel>=0.46.2"

# Copy backend application components only.
COPY backend /app/backend
COPY agents /app/agents
COPY config /app/config
COPY llm /app/llm
COPY orchestration /app/orchestration
COPY prompts /app/prompts
COPY skills /app/skills
COPY tools /app/tools

COPY database.py lead_quality.py schemas.py /app/

EXPOSE 8080

CMD ["uvicorn", "backend.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8080"]