# ============================================================================
# LLM providers
# ============================================================================
# Groq (https://console.groq.com) - fast inference, generous free tier, serves
# open-weight models (e.g. Llama). This is the router's "low" tier provider.
# If you hit "rate limit reached" / tokens-per-minute errors on
# llama-3.3-70b-versatile, switch to a smaller model with a much higher TPM
# allowance on Groq's free tier, e.g. GROQ_MODEL_ID=llama-3.1-8b-instant
GROQ_API_KEY=
GROQ_MODEL_ID=llama-3.3-70b-versatile

# OpenAI - the router's "high" (paid) tier provider.
OPENAI_API_KEY=
# A stronger model (gpt-4o / gpt-4.1) completes each stage in fewer tool-call
# round-trips, which lowers TOTAL tokens per run.
#
# IMPORTANT about "tokens per minute" (TPM) 429 errors: TPM caps are per-model
# and depend on your OpenAI usage tier, and are NOT simply "higher for bigger
# models". On usage tier 1, gpt-4o-mini actually has the HIGHEST TPM (200K),
# while gpt-4o / gpt-4.1 are only ~30K TPM - so on a low tier, switching "up"
# can hit limits FASTER. If you keep getting TPM 429s:
#   1) raise your OpenAI usage tier (add credit) - the only real way to lift the cap, or
#   2) set OPENAI_MODEL_ID=gpt-4o-mini for the largest tier-1 TPM headroom.
OPENAI_MODEL_ID=gpt-4o

# Local, free open-source LLM served via Ollama (https://ollama.com). Always
# the last-resort fallback for BOTH tiers if the configured cloud provider(s)
# keep failing (bad/missing key, an outage, or a rate limit that hasn't
# cleared even after the router's own retries) - see llm/router.py.
# Install Ollama, then pull a tool-calling-capable model, e.g.:
#   ollama pull qwen2.5:7b        (recommended - reliable tool/function calling)
#   ollama pull qwen2.5:14b       (better quality, needs more RAM/VRAM)
#   ollama pull deepseek-v2.5     (also supports tool calling; larger download)
# Note: deepseek-r1 reasoning models do NOT support tool calling in Ollama - avoid for this app.
OLLAMA_MODEL_ID=qwen2.5:7b
# Only set this if Ollama isn't running on the default http://localhost:11434
OLLAMA_HOST=

# ============================================================================
# LLM router - per-agent complexity tier ("low" = Groq open-weight, "high" =
# OpenAI paid). Local Ollama is always the emergency fallback regardless of
# these settings. All three default to "high"; dial specific stages down to
# "low" once you've checked the quality is good enough for that stage.
# ============================================================================
BUSINESS_RESEARCH_TIER=high
LEAD_SOURCE_TIER=high
LEAD_PULLER_TIER=high

# Retries on the primary model itself (rate-limit/transient errors) before
# falling back to the next model in the chain.
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY_SECONDS=10

# ============================================================================
# Search / places APIs
# ============================================================================
# SerpAPI (https://serpapi.com) - used by the Lead Source Research Agent for Google search
SERP_API_KEY=

# Google Places API (https://console.cloud.google.com -> enable "Places API")
# Used by the Lead Source Research Agent to find local small businesses by category/location
GOOGLE_PLACES_API_KEY=

# ============================================================================
# Web scraping fallback chain (tools/scraping/): requests -> Scrapling ->
# Crawl4AI -> Playwright, cheapest/most-likely-to-work first.
# ============================================================================
# Hard cap on how many engines the chain will try for a single URL. Set to 1
# to disable the fallback entirely (requests-only); default 4 tries every
# engine once. This is what guarantees a bad/unreachable URL can never loop
# through scraping engines indefinitely.
SCRAPER_MAX_ATTEMPTS=4
SCRAPER_REQUEST_TIMEOUT_SECONDS=10
PLAYWRIGHT_TIMEOUT_MS=15000

# ============================================================================
# Orchestration (orchestration/lead_pipeline.py)
# ============================================================================
# Max retries Agno's Workflow/Step machinery attempts for a single stage
# before giving up on that stage of the pipeline.
WORKFLOW_STEP_MAX_RETRIES=3

# ============================================================================
# Frontend (frontend/streamlit_app.py)
# ============================================================================
# Where the Streamlit app should reach the FastAPI backend. Overridden to
# http://backend:8000 automatically when run via docker-compose.
BACKEND_URL=http://localhost:8000

# ============================================================================
# Debugging
# ============================================================================
# When true, streams verbose per-agent tool-call/reasoning traces to the
# console (Agno's debug_mode), on top of the pipeline's own always-on INFO
# progress logs. Leave false for quieter output.
DEBUG_MODE=false
