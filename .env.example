# Model priority for all three Agno agents: Groq (if GROQ_API_KEY is set) -> OpenAI
# (if OPENAI_API_KEY is set) -> local Ollama (no key needed). Whichever cloud key you
# set is used as primary; the other cloud provider is simply ignored.

# Groq (https://console.groq.com) - fast inference, generous free tier.
# If you hit "rate limit reached" / tokens-per-minute errors on llama-3.3-70b-versatile,
# switch to a smaller model with a much higher TPM allowance on Groq's free tier, e.g.
# GROQ_MODEL_ID=llama-3.1-8b-instant
GROQ_API_KEY=
GROQ_MODEL_ID=llama-3.3-70b-versatile

# OpenAI (used only if GROQ_API_KEY is not set)
OPENAI_API_KEY=
# Model for all three agents. A stronger model (gpt-4o / gpt-4.1) completes each stage
# in fewer tool-call round-trips, which lowers TOTAL tokens per run.
#
# IMPORTANT about "tokens per minute" (TPM) 429 errors: TPM caps are per-model and
# depend on your OpenAI usage tier, and are NOT simply "higher for bigger models".
# On usage tier 1, gpt-4o-mini actually has the HIGHEST TPM (200K), while gpt-4o /
# gpt-4.1 are only ~30K TPM - so on a low tier, switching "up" can hit limits FASTER.
# If you keep getting TPM 429s:
#   1) raise your OpenAI usage tier (add credit) - the only real way to lift the cap, or
#   2) set OPENAI_MODEL_ID=gpt-4o-mini for the largest tier-1 TPM headroom.
# The app already retries with backoff and falls back to local Ollama when the cap is hit.
OPENAI_MODEL_ID=gpt-4o

# Local, free open-source LLM served via Ollama (https://ollama.com). Used as the
# primary model if neither GROQ_API_KEY nor OPENAI_API_KEY is set. Also used as an
# automatic fallback if the primary cloud model keeps failing (bad/missing key, an
# outage, or a rate limit that hasn't cleared even after Agno retries the primary
# with backoff) - see _RETRY_KWARGS and _fallback_config in agents.py.
# Install Ollama, then pull a tool-calling-capable model, e.g.:
#   ollama pull qwen2.5:7b        (recommended - reliable tool/function calling)
#   ollama pull qwen2.5:14b       (better quality, needs more RAM/VRAM)
#   ollama pull deepseek-v2.5     (also supports tool calling; larger download)
# Note: deepseek-r1 reasoning models do NOT support tool calling in Ollama - avoid for this app.
OLLAMA_MODEL_ID=qwen2.5:7b
# Only set this if Ollama isn't running on the default http://localhost:11434
OLLAMA_HOST=

# SerpAPI (https://serpapi.com) - used by the Lead Source Research Agent for Google search
SERP_API_KEY=

# Google Places API (https://console.cloud.google.com -> enable "Places API")
# Used by the Lead Source Research Agent to find local small businesses by category/location
GOOGLE_PLACES_API_KEY=

# Debug logging - when true, streams verbose per-agent tool-call/reasoning traces
# to the console (Agno's debug_mode), on top of the pipeline's own always-on INFO
# progress logs. Leave false for quieter output.
DEBUG_MODE=false
